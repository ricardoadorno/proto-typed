{
  "name": "@proto-typed/extension",
  "displayName": "Proto-Typed DSL",
  "description": "VSCode extension for the Proto-Typed DSL.",
  "version": "0.0.1",
  "publisher": "proto-typed",
  "icon": "logo.svg",
  "engines": {
    "vscode": "^1.83.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:proto-typed"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "proto-typed",
        "aliases": [
          "Proto-Typed",
          "proto-typed"
        ],
        "extensions": [
          ".pty"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./logo.svg",
          "dark": "./logo.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "proto-typed",
        "scopeName": "source.pty",
        "path": "./syntaxes/proto-typed.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "proto-typed",
        "path": "./snippets/snippets.json"
      }
    ],
    "themes": [
      {
        "label": "Proto-Typed Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/proto-typed-dark.json"
      }
    ],
    "commands": [
      {
        "command": "proto-typed.showPreview",
        "title": "Open Preview to the Side",
        "category": "Proto-Typed",
        "icon": "./logo.svg"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "proto-typed.showPreview",
          "when": "editorLangId == proto-typed",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "proto-typed.showPreview",
          "when": "editorLangId == proto-typed"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "pnpm run build:webview && pnpm --workspace-root run compile:core && pnpm --workspace-root exec tsc -p packages/extension/tsconfig.json",
    "build:webview": "cd webview && pnpm install && pnpm run build",
    "dev:webview": "cd webview && pnpm run dev",
    "watch": "tsc -watch -p ./",
    "watch:webview": "cd webview && pnpm run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run compile",
    "test": "node ./dist/test/runTest.js",
    "test:update-snapshots": "cross-env UPDATE_SNAPSHOTS=1 pnpm test"
  },
  "dependencies": {
    "@proto-typed/core": "workspace:*"
  },
  "devDependencies": {
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.83.0",
    "@vscode/test-electron": "^2.3.8",
    "chai": "^4.3.10",
    "cross-env": "^7.0.3",
    "mocha": "^10.4.0",
    "pixelmatch": "^5.3.0",
    "playwright-core": "^1.56.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.2.2"
  }
}
