{
  "name": "@proto-typed/extension",
  "version": "0.1.0",
  "description": "VS Code extension for Proto-Typed DSL",
  "private": true,
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onLanguage:proto-typed"
  ],
  "contributes": {
    "languages": [
      {
        "id": "proto-typed",
        "aliases": ["Proto-Typed", "proto-typed"],
        "extensions": [".dsl"],
        "configuration": "./language-configuration.json"
      }
    ]
  },
  "scripts": {
    "build": "echo 'Extension build not implemented yet'",
    "watch": "echo 'Extension watch not implemented yet'"
  },
  "dependencies": {
    "@proto-typed/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.8.1",
    "@types/vscode": "^1.80.0",
    "typescript": "~5.7.2"
  }
}
