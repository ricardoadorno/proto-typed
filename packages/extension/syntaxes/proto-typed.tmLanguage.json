{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Proto-Typed DSL",
  "scopeName": "source.pty",
  "fileTypes": [".pty"],
  "patterns": [
    { "include": "#views" },
    { "include": "#components" },
    { "include": "#styles" },
    { "include": "#typography" },
    { "include": "#buttons" },
    { "include": "#linksAndImages" },
    { "include": "#forms" },
    { "include": "#layouts" },
    { "include": "#structures" },
    { "include": "#delimiters" }
  ],
  "repository": {
    "views": {
      "patterns": [
        {
          "name": "meta.section.proto.view",
          "match": "^\\s*(screen|modal|drawer)\\s+(\\w+)\\s*(:)",
          "captures": {
            "1": { "name": "keyword.view.proto" },
            "2": { "name": "entity.name.view.proto" },
            "3": { "name": "punctuation.separator.key-value.proto" }
          }
        }
      ]
    },

    "components": {
      "patterns": [
        {
          "name": "meta.section.proto.component",
          "match": "^\\s*(component)\\s+(\\w+)\\s*(:)",
          "captures": {
            "1": { "name": "keyword.component.proto" },
            "2": { "name": "entity.name.component.proto" },
            "3": { "name": "punctuation.separator.key-value.proto" }
          }
        },
        {
          "name": "variable.other.component.instance.proto",
          "match": "\\$[A-Z]\\w*"
        },
        {
          "name": "variable.parameter.component.prop.proto",
          "match": "%\\w+"
        }
      ]
    },

    "styles": {
      "patterns": [
        {
          "name": "keyword.styles.proto",
          "match": "^\\s*styles\\s*:"
        },
        {
          "name": "support.type.property-name.css.proto",
          "match": "--[\\w-]+"
        }
      ]
    },

    "typography": {
      "patterns": [
        {
          "name": "markup.heading.proto",
          "match": "^\\s*(#{1,6})(?=\\s)"
        },
        {
          "name": "markup.muted.proto",
          "match": "^\\s*(>>>)(?=\\s)"
        },
        {
          "name": "markup.text.proto",
          "match": "^\\s*(>>)(?=\\s)"
        },
        {
          "name": "markup.paragraph.proto",
          "match": "^\\s*(>)(?=\\s)"
        },
        {
          "name": "markup.note.proto",
          "match": "^\\s*(\\*>)(?=\\s)"
        },
        {
          "name": "markup.quote.proto",
          "match": "^\\s*(\">)(?=\\s)"
        }
      ]
    },

    "buttons": {
      "patterns": [
        {
          "name": "keyword.button.proto",
          "match": "@(primary|secondary|outline|ghost|destructive|link|success|warning)(?:-(xs|sm|md|lg))?(?=\\[)"
        },
        {
          "name": "keyword.button.proto",
          "match": "@(?=\\[)"
        }
      ]
    },

    "linksAndImages": {
      "patterns": [
        {
          "name": "keyword.link.proto",
          "match": "#(?=\\[)"
        },
        {
          "name": "keyword.image.proto",
          "match": "!(?=\\[)"
        },
        {
          "name": "entity.name.icon.proto",
          "match": "\\bi-[A-Z]\\w*\\b"
        },
        {
          "name": "entity.name.reference.proto",
          "match": "(?<=\\]\\()[A-Z]\\w*(?=\\))"
        }
      ]
    },

    "forms": {
      "patterns": [
        {
          "name": "keyword.input.email.proto",
          "match": "(?i:___(?:email)\\b)"
        },
        {
          "name": "keyword.input.password.proto",
          "match": "(?i:___(?:password)\\b)"
        },
        {
          "name": "keyword.input.date.proto",
          "match": "(?i:___(?:date)\\b)"
        },
        {
          "name": "keyword.input.number.proto",
          "match": "(?i:___(?:number)\\b)"
        },
        {
          "name": "keyword.input.textarea.proto",
          "match": "(?i:___(?:textarea)\\b)"
        },
        {
          "name": "keyword.input.proto",
          "match": "___[\\*\\-]?"
        },
        {
          "name": "constant.language.checkbox.proto",
          "match": "\\[[X\\s]\\]"
        },
        {
          "name": "constant.language.radio.proto",
          "match": "^\\s*\\([X\\s]\\)"
        }
      ]
    },

    "layouts": {
      "patterns": [
        {
          "name": "keyword.layout.proto",
          "match": "\\b(container-narrow|container-wide|container-full|container|stack-flush|stack-tight|stack-loose|stack|row-start|row-center|row-between|row-end|row|col|grid-2|grid-3|grid-4|grid-auto|grid|card-compact|card-feature|card|sidebar|navigator|list|fab)\\b"
        }
      ]
    },

    "structures": {
      "patterns": [
        {
          "name": "keyword.structure.proto",
          "match": "\\bheader\\b"
        },
        {
          "name": "delimiter.separator.proto",
          "match": "^\\s*---+\\s*$"
        },
        {
          "name": "markup.list.proto",
          "match": "^\\s*(-)(?=\\s)"
        }
      ]
    },

    "delimiters": {
      "patterns": [
        {
          "name": "punctuation.separator.pipe.proto",
          "match": "\\|"
        },
        {
          "name": "punctuation.section.brackets.proto",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.braces.proto",
          "match": "[{}]"
        },
        {
          "name": "punctuation.separator.key-value.proto",
          "match": ":"
        }
      ]
    }
  }
}
