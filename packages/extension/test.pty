
Test 1: Views and Navigation
screen Home:
  header:
    # 🏠 Welcome Home
  
  container:
    > This is a paragraph with spacing
    >> Regular text without spacing
    >>> Muted secondary text
    
    *> This is a highlighted note
    "> This is a quoted text
    
    ---
    
    ## Quick Actions
    @[Go to Settings](Settings)
    @secondary[View Profile](Profile)
    @ghost[Cancel](-)
    
screen Settings:
  header:
    # ⚙️ Settings
    @ghost[Back](Home)
  
  container:
    card:
      ### User Preferences
      
      ___:Username{Enter your username}
      ___email:Email{your@email.com}
      ___*:Password{Enter password}
      
      [X] Remember me
      [ ] Enable notifications
      
      @[Save Changes](Home)

Test 2: Components
component UserCard:
  card:
    # %name
    > Role: %role
    >>> Member since %year

screen Team:
  header:
    # 👥 Team Members
  
  container:
    list $UserCard:
      - Alice | Developer | 2023
      - Bob | Designer | 2022
      - Carol | Manager | 2021

Test 3: Layouts
screen Dashboard:
  header:
    # 📊 Dashboard
  
  container:
    row:
      card:
        ## Users
        # 1,234
      
      card:
        ## Revenue
        # $56,789
    
    ---
    
    grid:
      card:
        ### Active
        > 89 sessions
      
      card:
        ### Pending
        > 12 tasks
      
      card:
        ### Complete
        > 145 items

Test 4: Forms
screen ContactForm:
  header:
    # 📧 Contact Us
  
  container:
    card:
      ## Send us a message
      
      ___:Name{Your full name}
      ___email:Email{your@email.com}
      ___:Subject{Message subject}
      ___textarea:Message{Type your message}
      
      ___:Country{Select}[USA | Canada | Mexico | Brazil]
      
      [X] Send me a copy
      [ ] Subscribe to newsletter
      
      (X) Email
      ( ) Phone
      ( ) Text
      
      row:
        @[Send Message](send)
        @ghost[Cancel](Home)

Test 5: Navigator
screen AppMain:
  header:
    # 🧭 Navigation Test
  
  container:
    > Use the navigator below to switch between screens
  
  navigator:
    - i-Home Dashboard | Home
    - i-Settings Config | Settings
    - i-Users Team | Team
    - i-Mail Contact | ContactForm
  
  fab{plus}(addNew)

Test 6: Styles
styles:
  --primary-color: #3b82f6;
  --secondary-color: #8b5cf6;
  --success-color: #10b981;
  --warning-color: #f59e0b;
  --danger-color: #ef4444;
  --spacing: 1rem;
  --radius: 0.5rem;

Test 7: Typography
screen Typography:
  header:
    # Typography Showcase
  
  container:
    # Heading 1
    ## Heading 2
    ### Heading 3
    #### Heading 4
    ##### Heading 5
    ###### Heading 6
    
    ---
    
    > Paragraph with spacing
    >> Text without spacing
    >>> Muted text
    
    ---
    
    list:
      - First item
      - Second item
      - Third item
      - Fourth item

