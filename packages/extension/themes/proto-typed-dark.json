{
  "name": "Proto-Typed Dark Tokens",
  "type": "dark",
  "semanticHighlighting": true,
  "tokenColors": [
    {
      "name": "View keywords",
      "scope": ["keyword.view.proto", "keyword.structure.proto"],
      "settings": { "foreground": "#ff6b6b", "fontStyle": "bold" }
    },
    {
      "name": "View names",
      "scope": ["entity.name.view.proto"],
      "settings": { "foreground": "#00d9ff", "fontStyle": "bold" }
    },
    {
      "name": "Component keyword",
      "scope": ["keyword.component.proto"],
      "settings": { "foreground": "#ff6b6b", "fontStyle": "bold" }
    },
    {
      "name": "Component names",
      "scope": [
        "entity.name.component.proto",
        "variable.other.component.instance.proto"
      ],
      "settings": { "foreground": "#4ade80", "fontStyle": "bold" }
    },
    {
      "name": "Component props",
      "scope": ["variable.parameter.component.prop.proto"],
      "settings": { "foreground": "#f59e0b", "fontStyle": "italic" }
    },
    {
      "name": "Styles keyword",
      "scope": ["keyword.styles.proto"],
      "settings": { "foreground": "#a78bfa", "fontStyle": "bold" }
    },
    {
      "name": "CSS custom properties",
      "scope": ["support.type.property-name.css.proto"],
      "settings": { "foreground": "#8b5cf6" }
    },
    {
      "name": "Layouts",
      "scope": ["keyword.layout.proto"],
      "settings": { "foreground": "#ec4899", "fontStyle": "bold" }
    },
    {
      "name": "Typography headings",
      "scope": ["markup.heading.proto"],
      "settings": { "foreground": "#34d399", "fontStyle": "bold" }
    },
    {
      "name": "Typography text",
      "scope": [
        "markup.paragraph.proto",
        "markup.text.proto",
        "markup.muted.proto"
      ],
      "settings": { "foreground": "#34d399" }
    },
    {
      "name": "Typography note",
      "scope": ["markup.note.proto"],
      "settings": { "foreground": "#34d399", "fontStyle": "italic" }
    },
    {
      "name": "Typography quote",
      "scope": ["markup.quote.proto"],
      "settings": { "foreground": "#34d399", "fontStyle": "italic" }
    },
    {
      "name": "Lists",
      "scope": ["markup.list.proto"],
      "settings": { "foreground": "#fbbf24" }
    },
    {
      "name": "Buttons",
      "scope": ["keyword.button.proto"],
      "settings": { "foreground": "#60a5fa", "fontStyle": "bold" }
    },
    {
      "name": "Links & images",
      "scope": ["keyword.link.proto", "keyword.image.proto"],
      "settings": { "foreground": "#60a5fa", "fontStyle": "bold" }
    },
    {
      "name": "Icons",
      "scope": ["entity.name.icon.proto"],
      "settings": { "foreground": "#ff8c00" }
    },
    {
      "name": "Route references",
      "scope": ["entity.name.reference.proto"],
      "settings": { "foreground": "#00d9ff" }
    },
    {
      "name": "Form fields",
      "scope": [
        "keyword.input.proto",
        "keyword.input.email.proto",
        "keyword.input.password.proto",
        "keyword.input.date.proto",
        "keyword.input.number.proto",
        "keyword.input.textarea.proto"
      ],
      "settings": { "foreground": "#a855f7" }
    },
    {
      "name": "Checkboxes & radios",
      "scope": [
        "constant.language.checkbox.proto",
        "constant.language.radio.proto"
      ],
      "settings": { "foreground": "#a855f7", "fontStyle": "bold" }
    },
    {
      "name": "Delimiters",
      "scope": [
        "punctuation.separator.key-value.proto",
        "punctuation.section.brackets.proto",
        "punctuation.section.braces.proto",
        "punctuation.separator.pipe.proto",
        "delimiter.separator.proto"
      ],
      "settings": { "foreground": "#ffe66d" }
    }
  ]
}
