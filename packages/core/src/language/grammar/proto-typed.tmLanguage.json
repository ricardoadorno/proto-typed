{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Proto-Typed DSL",
  "scopeName": "source.pty",
  "fileTypes": [".pty"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#values" },
    { "include": "#meta" },
    { "include": "#head" },
    { "include": "#views" },
    { "include": "#components" },
    { "include": "#styles" },
    { "include": "#typography" },
    { "include": "#buttons" },
    { "include": "#linksAndImages" },
    { "include": "#forms" },
    { "include": "#layouts" },
    { "include": "#structures" },
    { "include": "#delimiters" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.pty",
          "match": "^\\s*//.*$"
        }
      ]
    },

    "values": {
      "patterns": [
        {
          "name": "constant.numeric.color.hex.pty",
          "match": "#[0-9A-Fa-f]{3,8}\\b"
        },
        {
          "name": "constant.numeric.pty",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        },
        {
          "name": "string.quoted.double.pty",
          "match": "\"[^\"]*\""
        },
        {
          "name": "string.quoted.single.pty",
          "match": "'[^']*'"
        }
      ]
    },

    "meta": {
      "patterns": [
        {
          "name": "meta.section.meta.pty",
          "match": "^\\s*(meta)\\s*(:)",
          "captures": {
            "1": { "name": "entity.name.tag.pty" },
            "2": { "name": "punctuation.separator.pty" }
          }
        },
        {
          "name": "meta.property.meta.pty",
          "match": "^\\s+(version|title)\\s*(:)",
          "captures": {
            "1": { "name": "variable.other.property.pty" },
            "2": { "name": "punctuation.separator.pty" }
          }
        }
      ]
    },

    "head": {
      "patterns": [
        {
          "name": "meta.section.head.pty",
          "match": "^\\s*(head)\\s*(:)",
          "captures": {
            "1": { "name": "entity.name.tag.pty" },
            "2": { "name": "punctuation.separator.pty" }
          }
        },
        {
          "name": "meta.section.head-subsection.pty",
          "match": "^\\s+(color|font|template)\\s*(:)",
          "captures": {
            "1": { "name": "entity.name.type.pty" },
            "2": { "name": "punctuation.separator.pty" }
          }
        },
        {
          "name": "meta.property.head-color.pty",
          "match": "^\\s+(primary|secondary|neutral|accent|base|family|default)\\s*(:)",
          "captures": {
            "1": { "name": "variable.other.property.pty" },
            "2": { "name": "punctuation.separator.pty" }
          }
        }
      ]
    },

    "views": {
      "patterns": [
        {
          "name": "meta.section.view.pty",
          "match": "^\\s*(screen|modal|drawer)\\s+(\\w+)\\s*(:)",
          "captures": {
            "1": { "name": "keyword.control.pty" },
            "2": { "name": "entity.name.class.pty" },
            "3": { "name": "punctuation.separator.pty" }
          }
        }
      ]
    },

    "components": {
      "patterns": [
        {
          "name": "meta.section.component.pty",
          "match": "^\\s*(component)\\s+(\\w+)\\s*(:)",
          "captures": {
            "1": { "name": "keyword.control.pty" },
            "2": { "name": "entity.name.function.pty" },
            "3": { "name": "punctuation.separator.pty" }
          }
        },
        { "match": "\\$[A-Z]\\w*", "name": "variable.other.constant.pty" },
        { "match": "%[a-zA-Z][\\w-]*", "name": "variable.parameter.pty" }
      ]
    },

    "styles": {
      "patterns": [
        { "match": "^\\s*styles\\s*:", "name": "keyword.other.pty" },
        { "match": "--[\\w-]+", "name": "support.constant.property-name.pty" }
      ]
    },

    "typography": {
      "patterns": [
        {
          "match": "^\\s*(#{1,4})\\s+(.+)$",
          "captures": {
            "1": { "name": "markup.heading.pty" },
            "2": { "name": "markup.heading.content.pty" }
          }
        },
        {
          "match": "^\\s*(\\*\\*>)\\s+(.+)$",
          "captures": {
            "1": { "name": "markup.bold.pty" },
            "2": { "name": "markup.note.pty" }
          }
        },
        {
          "match": "^\\s*(\\*(?!\\*)>)\\s+(.+)$",
          "captures": {
            "1": { "name": "markup.italic.pty" },
            "2": { "name": "markup.quote.pty" }
          }
        },
        {
          "match": "^\\s*(>>>)\\s+(.+)$",
          "captures": {
            "1": { "name": "punctuation.definition.pty" },
            "2": { "name": "comment.line.pty" }
          }
        },
        {
          "match": "^\\s*(>>)\\s+(.+)$",
          "captures": {
            "1": { "name": "punctuation.definition.pty" },
            "2": { "name": "markup.italic.pty" }
          }
        },
        {
          "match": "^\\s*(>)\\s+(.+)$",
          "captures": {
            "1": { "name": "punctuation.definition.pty" },
            "2": { "name": "string.unquoted.pty" }
          }
        }
      ]
    },
    "buttons": {
      "patterns": [
        {
          "match": "@(primary|secondary|outline|ghost|destructive|link|success|warning)(?:-(small|icon|large))?",
          "name": "support.function.pty"
        },
        { "match": "@", "name": "support.function.pty" }
      ]
    },

    "linksAndImages": {
      "patterns": [
        { "match": "#(?=\\[)", "name": "variable.other.constant.pty" },
        {
          "match": "!(?:rounded|circle)(?:-\\d+x\\d+)?(?=\\[)",
          "name": "variable.other.constant.pty"
        },
        { "match": "!(?=\\[)", "name": "variable.other.constant.pty" },
        { "match": "\\bi-[A-Z]\\w*\\b", "name": "variable.other.constant.pty" },
        {
          "match": "(?<=\\]\\()[A-Z]\\w*(?=\\))",
          "name": "entity.name.type.pty"
        },
        {
          "match": "(?<=\\()\\s*https?:\\/\\/[^\\s)]+(?=\\))",
          "name": "entity.name.type.pty"
        }
      ]
    },

    "forms": {
      "patterns": [
        {
          "match": "(?i:___(?:email|password|date|number|textarea|text|select)?)(?=\\s*\\[)",
          "name": "string.pty"
        },
        { "match": "\\[[X\\s]\\]", "name": "constant.language.boolean.pty" },
        {
          "match": "^\\s*\\([X\\s]\\)",
          "name": "constant.language.boolean.pty"
        }
      ]
    },

    "layouts": {
      "patterns": [
        {
          "match": "\\b(header|container-narrow|container-wide|container-full|container|stack-none|stack-flush|stack-tight|stack-loose|stack|row-start|row-center|row-between|row-end|row|grid-2|grid-3|grid-4|grid-responsive|grid-auto|grid|layer-overlay|layer-sticky|layer-fixed|layer-absolute|layer-relative|layer-static|scroll-x|scroll-y|scroll-auto|scroll-hidden|card-compact|card-feature|card|sidebar|navigator|list|fab)\\b",
          "name": "storage.type.pty"
        }
      ]
    },

    "structures": {
      "patterns": [
        { "match": "^\\s*---+\\s*$", "name": "keyword.operator.symbol.pty" },
        { "match": "^\\s*-\\s+", "name": "keyword.operator.symbol.pty" }
      ]
    },

    "delimiters": {
      "patterns": [
        { "match": "\\|", "name": "keyword.operator.symbol.pty" },
        { "match": ":", "name": "keyword.operator.symbol.pty" }
      ]
    }
  }
}
