{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "module": "ES2020",
    "moduleResolution": "bundler",
    "target": "ES2020"
  },
  "include": ["src"],
  "exclude": [
    "tests",
    "**/*.test.ts",
    "**/*.spec.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "dist"
  ]
}
