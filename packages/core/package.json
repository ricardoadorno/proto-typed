{
  "name": "@proto-typed/core",
  "version": "0.1.0",
  "description": "Proto-Typed DSL core - lexer, parser, formatter, linter, diagnostics and language server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./language": {
      "types": "./dist/language/index.d.ts",
      "import": "./dist/language/index.js"
    },
    "./language/engine": {
      "types": "./dist/language/engine/engine.d.ts",
      "import": "./dist/language/engine/engine.js"
    },
    "./language/grammar": {
      "types": "./dist/language/grammar/index.d.ts",
      "import": "./dist/language/grammar/index.js"
    },
    "./language/adapters/vscode": {
      "types": "./dist/language/adapters/vscode.d.ts",
      "import": "./dist/language/adapters/vscode.js"
    },
    "./language/adapters/monaco": {
      "types": "./dist/language/adapters/monaco.d.ts",
      "import": "./dist/language/adapters/monaco.js"
    }
  },
  "scripts": {
    "build": "tsc && node ./scripts/copy-language-assets.mjs || tsc",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "chevrotain": "^11.0.3",
    "lucide": "^0.468.0",
    "shiki": "^1.3.0",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-textdocument": "^1.0.11",
    "vscode-languageserver-types": "^3.17.5"
  },
  "devDependencies": {
    "@shikijs/monaco": "^1.3.0",
    "@types/node": "24.8.1",
    "@types/vscode": "^1.83.0",
    "monaco-editor": "^0.52.0",
    "typescript": "~5.7.2",
    "vitest": "^4.0.8",
    "vitest-dom": "^0.1.1"
  },
  "files": [
    "dist",
    "src"
  ]
}
