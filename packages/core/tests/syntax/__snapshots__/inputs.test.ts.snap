<button class="inline-flex items-center justify-center   focus:outline-none focus:ring-2 transition-colors duration-200 h-10 px-5 text-sm" style="border-radius: var(--radius); focus-ring-color: var(--ring); background-color: var(--secondary); color: var(--secondary-foreground);" data-nav="upload" data-nav-type="internal">Change Photo</button></div>
<label class="block text-sm font-medium" style="color: var(--foreground);">Username:
  <input type="text" class="w-full px-3 py-2 shadow-sm focus:outline-none focus:ring-2 transition-colors mt-1" style="border: 1px solid var(--input); border-radius: var(--radius); background-color: var(--background); color: var(--foreground); ring-color: var(--ring);" placeholder="johndoe" />
</label>
<label class="block text-sm font-medium" style="color: var(--foreground);">Email:
  <input type="email" class="w-full px-3 py-2 shadow-sm focus:outline-none focus:ring-2 transition-colors mt-1" style="border: 1px solid var(--input); border-radius: var(--radius); background-color: var(--background); color: var(--foreground); ring-color: var(--ring);" placeholder="john@example.com" />
</label>
<label class="block text-sm font-medium" style="color: var(--foreground);">Bio:
  <textarea class="w-full px-3 py-2 shadow-sm focus:outline-none focus:ring-2 transition-colors mt-1"
    cols="30"
    rows="10"
    style="border: 1px solid var(--input); border-radius: var(--radius); background-color: var(--background); color: var(--foreground); ring-color: var(--ring);" placeholder="Tell us about yourself"></textarea>
</label>
<hr class="my-6 border-border" />
<h1 class="scroll-m-20 text-4xl font-extrabold tracking-tight text-[var(--fg-primary)]">Settings</h1>
<div class="flex flex-col gap-3" style=""><label class="flex items-center space-x-3 cursor-pointer">
    <input type="checkbox" checked class="w-4 h-4 rounded focus:ring-2 transition-colors" style="accent-color: var(--primary); background-color: var(--background); border: 1px solid var(--input); ring-color: var(--primary);" />
    <span style="color: var(--foreground);">Public profile</span>
  </label>
<label class="flex items-center space-x-3 cursor-pointer">
    <input type="checkbox" checked class="w-4 h-4 rounded focus:ring-2 transition-colors" style="accent-color: var(--primary); background-color: var(--background); border: 1px solid var(--input); ring-color: var(--primary);" />
    <span style="color: var(--foreground);">Show email</span>
  </label>
<label class="flex items-center space-x-3 cursor-pointer">
    <input type="checkbox"  class="w-4 h-4 rounded focus:ring-2 transition-colors" style="accent-color: var(--primary); background-color: var(--background); border: 1px solid var(--input); ring-color: var(--primary);" />
    <span style="color: var(--foreground);">Show location</span>
  </label></div>
<hr class="my-6 border-border" />
<div class="flex flex-row items-center justify-between gap-4" style=""><button class="inline-flex items-center justify-center   focus:outline-none focus:ring-2 transition-colors duration-200 h-10 px-5 text-sm" style="border-radius: var(--radius); focus-ring-color: var(--ring); background-color: var(--destructive); color: var(--destructive-foreground);" data-nav="delete" data-nav-type="internal">Delete Account</button>
<div class="flex flex-row items-center gap-6" style=""><button class="inline-flex items-center justify-center   focus:outline-none focus:ring-2 transition-colors duration-200 h-10 px-5 text-sm" style="border-radius: var(--radius); focus-ring-color: var(--ring); background-color: var(--secondary); color: var(--secondary-foreground);" data-nav="cancel" data-nav-type="internal">Cancel</button>
<button class="inline-flex items-center justify-center   focus:outline-none focus:ring-2 transition-colors duration-200 h-10 px-5 text-sm" style="border-radius: var(--radius); focus-ring-color: var(--ring); background-color: var(--primary); color: var(--primary-foreground);" data-nav="save" data-nav-type="internal">Save Changes</button></div></div></div></div></div>"
`;

