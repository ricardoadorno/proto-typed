{
  "name": "proto-typed-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Proto-Typed DSL monorepo - Core, Web, and Extension",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @proto-typed/web dev",
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @proto-typed/core build",
    "build:extension": "pnpm --filter @proto-typed/extension build",
    "build:web": "pnpm --filter @proto-typed/web build",
    "test": "pnpm --filter @proto-typed/core test",
    "test:run": "pnpm --filter @proto-typed/core test:run",
    "test:coverage": "pnpm --filter @proto-typed/core test:coverage",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "24.8.1",
    "typescript": "~5.7.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
