{
  "name": "proto-typed-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Proto-Typed DSL monorepo - Core, Web, and Extension",
  "type": "module",
  "scripts": {
    "dev": "pnpm -F @web/app dev",
    "build": "pnpm -F @web/app build",
    "preview": "pnpm -F @web/app start",
    "compile:core": "pnpm exec tsc -p packages/core/tsconfig.json",
    "compile:extension": "pnpm run -F proto-typed-vscode-extension compile",
    "generate:extension": "pnpm run -F proto-typed-vscode-extension vsce:package",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:errors": "eslint . --quiet",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm run test:e2e:web && pnpm run test:e2e:extension",
    "test:e2e:web": "pnpm --filter @web/app test:e2e",
    "test:e2e:web:ui": "pnpm --filter @web/app test:e2e:ui",
    "test:e2e:web:debug": "pnpm --filter @web/app test:e2e:debug",
    "test:e2e:extension": "pnpm --filter proto-typed-vscode-extension test:extension:e2e",
    "test:e2e:extension:headed": "pnpm --filter proto-typed-vscode-extension test:extension:e2e:headed"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.105.0",
    "@vitest/ui": "^4.0.8",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "happy-dom": "^20.0.10",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.8"
  }
}
